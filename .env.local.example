# ── Ivera environment variables ──────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Set the SAME variables in Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser — only put browser-safe keys here.
# Never commit real secrets (DB password, service/secret keys).

# WhatsApp booking
NEXT_PUBLIC_WHATSAPP_NUMBER=995555443787
NEXT_PUBLIC_BRAND_NAME=Ivera

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL (public, not secret)
NEXT_PUBLIC_SUPABASE_URL=https://nslvqdxbpkgqppidwbff.supabase.co

# Browser key — use the new publishable key (sb_publishable_…). This is meant to
# be public and safe to expose in the client.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy fallback (optional). The app uses PUBLISHABLE_KEY if set, otherwise this.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Gemini AI (optional) ─────────────────────────────────────────────────────
# Server-side only — never prefix with NEXT_PUBLIC. AI features fall back
# gracefully when this is unset.
# GEMINI_API_KEY=your_gemini_api_key_here
