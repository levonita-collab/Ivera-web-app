# ── Ivera environment variables ──────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Set the SAME variables in Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser — only put browser-safe keys here.
# Never commit real secrets (DB password, service/secret keys).

# WhatsApp booking
NEXT_PUBLIC_WHATSAPP_NUMBER=995555443787
NEXT_PUBLIC_BRAND_NAME=Ivera

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL (public, not secret)
NEXT_PUBLIC_SUPABASE_URL=https://nslvqdxbpkgqppidwbff.supabase.co

# Browser key — use the new publishable key (sb_publishable_…). This is meant to
# be public and safe to expose in the client.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy fallback (optional). The app uses PUBLISHABLE_KEY if set, otherwise this.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC, NEVER commit.
# Bypasses Row Level Security entirely. Powers the admin API and the PayPal
# payment routes (src/lib/supabase/serviceClient.ts). Get it from
# Supabase Dashboard → Project Settings → API → service_role key.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Comma-separated allowlist of Supabase Auth emails allowed to use
# /admin/orders. Server-only — the browser never sees this list, only a
# 401/403 if the signed-in account isn't on it.
# ADMIN_EMAILS=levani@example.com

# ── Gemini AI (optional) ─────────────────────────────────────────────────────
# Server-side only — never prefix with NEXT_PUBLIC. AI features fall back
# gracefully when this is unset.
# GEMINI_API_KEY=your_gemini_api_key_here

# ── PayPal (optional) ────────────────────────────────────────────────────────
# Get these from https://developer.paypal.com/dashboard/applications (sandbox first).
# When unset, the "Pay with PayPal" option is hidden and WhatsApp booking still works.
#
# Client ID — safe to expose in the browser, used to load the PayPal JS SDK.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# Client Secret — server-side only, never prefix with NEXT_PUBLIC.
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# "sandbox" (default, for testing) or "live" (real payments).
# PAYPAL_MODE=sandbox

# PayPal doesn't support GEL — tour prices are converted to EUR at checkout.
# Optional: override the conversion rate (1 GEL = X EUR). Defaults to 0.34.
# Keep PAYPAL_GEL_EUR_RATE and NEXT_PUBLIC_PAYPAL_GEL_EUR_RATE in sync.
# PAYPAL_GEL_EUR_RATE=0.34
# NEXT_PUBLIC_PAYPAL_GEL_EUR_RATE=0.34

# Webhook ID from PayPal Developer Dashboard → your app → Webhooks, after
# registering https://<your-domain>/api/paypal/webhook for
# PAYMENT.CAPTURE.COMPLETED and PAYMENT.CAPTURE.REFUNDED. Optional — the
# webhook route no-ops safely if this is unset; the client-driven capture
# flow works either way. See docs/security-hardening-checklist.md.
# PAYPAL_WEBHOOK_ID=your_webhook_id_here
